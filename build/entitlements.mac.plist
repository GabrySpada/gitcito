<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Wails build. Deliberately empty.

  The Electron build needed allow-jit and allow-unsigned-executable-memory (V8 compiled JavaScript inside the
  app process), disable-library-validation (Electron's own frameworks) and allow-dyld-environment-variables.
  Under Wails the page runs in WKWebView, whose JavaScript and WebAssembly JIT live in Apple's separately
  signed WebContent process, and the app is one statically linked Go binary plus the gitcito-cli companion.
  None of those exceptions apply, so none are granted (docs/port/DECISIONS.md 021).
-->
<plist version="1.0">
  <dict/>
</plist>
