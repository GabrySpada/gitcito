  "resolveInputTokens": [
    {
      "value": {
        "name": "Run ${input:who}",
        "args": [
          "--from",
          "${input:who}",
          "${input:who}+${input:greeting}"
        ],
        "env": {
          "GREETING": "${input:greeting}",
          "KEEP": "${input:unknown}"
        },
        "nested": {
          "deep": [
            "${input:who}"
          ]
        },
        "port": 3000,
        "flag": true,
        "nothing": null
      },
      "values": {
        "who": "carlos",
        "greeting": "hola"
      },
      "out": {
        "name": "Run carlos",
        "args": [
          "--from",
          "carlos",
          "carlos+hola"
        ],
        "env": {
          "GREETING": "hola",
          "KEEP": "${input:unknown}"
        },
        "nested": {
          "deep": [
            "carlos"
          ]
        },
        "port": 3000,
        "flag": true,
        "nothing": null
      }
    },
    {
      "value": "${input:a}${input:b}${input:a}",
      "values": {
        "a": "1",
        "b": "$&"
      },
      "out": "1$&1"
    },
    {
      "value": "${input:}${input:x y}",
      "values": {
        "x y": "spaced"
      },
      "out": "${input:}spaced"
    },
    {
      "value": [
        "${input:a}",
        [
          "${input:a}"
        ]
      ],
      "values": {
        "a": "deep"
      },
      "out": [
        "deep",
        [
          "deep"
        ]
      ]
    },
    {
      "value": 42,
      "values": {
        "a": "x"
      },
      "out": 42
    }
