[
  {
    "name": "status with keys, one of them in the agent",
    "shot": true,
    "env": {
      "GITCITO_SSH_DIR": "<ROOT>/ssh",
      "HOME": "<ROOT>/home"
    },
    "files": {
      "ssh/id_ed25519": "PRIVATE — never read\n",
      "ssh/id_ed25519.pub": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample me@example.com\n",
      "ssh/id_rsa.pub": "﻿  ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQExample  \n\n",
      "ssh/broken.pub": "not a key\n",
      "ssh/folder.pub": null,
      "ssh/Work Key.pub": "ecdsa-sha2-nistp256 AAAAE2VjZHNhExample laptop key\n",
      "ssh/Work Key": "PRIVATE\n",
      "ssh/config": "Host *\n",
      "ssh/known_hosts": "github.com ssh-ed25519 AAAA\n",
      "home/.keep": ""
    },
    "bins": [
      "ssh",
      "ssh-add",
      "ssh-keygen"
    ],
    "replies": [
      {
        "argv": [
          "ssh-add",
          "-l"
        ],
        "stdout": "256 SHA256:aaa me@example.com (ED25519)\n"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/id_ed25519.pub"
        ],
        "stdout": "256 SHA256:aaa me@example.com (ED25519)\n",
        "code": 0
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/id_rsa.pub"
        ],
        "stdout": "3072 SHA256:bbb no comment (RSA)\n",
        "code": 0
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/broken.pub"
        ],
        "stdout": "",
        "code": 255,
        "stderr": "<ROOT>/ssh/broken.pub is not a public key file.\n"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/folder.pub"
        ],
        "stdout": "256 SHA256:ddd folder (ED25519)\n",
        "code": 0
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/Work Key.pub"
        ],
        "stdout": "256 SHA256:ccc laptop key (ECDSA)\n",
        "code": 0
      }
    ],
    "call": {
      "method": "status",
      "args": []
    },
    "result": {
      "dir": "<ROOT>/ssh",
      "keys": [
        {
          "file": "folder.pub",
          "path": "<ROOT>/ssh/folder.pub",
          "type": "ed25519",
          "bits": 256,
          "fingerprint": "SHA256:ddd",
          "comment": "folder",
          "publicKey": "",
          "inAgent": false,
          "hasPrivate": false
        },
        {
          "file": "id_ed25519.pub",
          "path": "<ROOT>/ssh/id_ed25519.pub",
          "type": "ed25519",
          "bits": 256,
          "fingerprint": "SHA256:aaa",
          "comment": "me@example.com",
          "publicKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample me@example.com",
          "inAgent": true,
          "hasPrivate": true
        },
        {
          "file": "id_rsa.pub",
          "path": "<ROOT>/ssh/id_rsa.pub",
          "type": "rsa",
          "bits": 3072,
          "fingerprint": "SHA256:bbb",
          "comment": "",
          "publicKey": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQExample",
          "inAgent": false,
          "hasPrivate": false
        },
        {
          "file": "Work Key.pub",
          "path": "<ROOT>/ssh/Work Key.pub",
          "type": "ecdsa",
          "bits": 256,
          "fingerprint": "SHA256:ccc",
          "comment": "laptop key",
          "publicKey": "ecdsa-sha2-nistp256 AAAAE2VjZHNhExample laptop key",
          "inAgent": false,
          "hasPrivate": true
        }
      ],
      "agentRunning": true
    },
    "calls": [
      {
        "argv": [
          "ssh-add",
          "-l"
        ],
        "env": {
          "DISPLAY": "",
          "SSH_ASKPASS": "",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/broken.pub"
        ],
        "env": {
          "DISPLAY": "",
          "SSH_ASKPASS": "",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/folder.pub"
        ],
        "env": {
          "DISPLAY": "",
          "SSH_ASKPASS": "",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/id_ed25519.pub"
        ],
        "env": {
          "DISPLAY": "",
          "SSH_ASKPASS": "",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/id_rsa.pub"
        ],
        "env": {
          "DISPLAY": "",
          "SSH_ASKPASS": "",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "ssh-keygen",
          "-lf",
          "<ROOT>/ssh/Work Key.pub"
        ],
        "env": {
          "DISPLAY": "",
          "SSH_ASKPASS": "",
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      }
    ],
    "askpassRemoved": true
  },
