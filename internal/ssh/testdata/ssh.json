  {
    "name": "generate creates the directory and sanitises the name",
    "shot": true,
    "env": {
      "GITCITO_SSH_DIR": "<ROOT>/new/ssh",
      "HOME": "<ROOT>/home"
    },
    "bins": [
      "ssh",
      "ssh-add",
      "ssh-keygen"
    ],
    "replies": [
      {
        "argv": [
          "ssh-keygen",
          "-t",
          "ed25519",
          "-f",
          "<ROOT>/new/ssh/mykey@host",
          "-C",
          "me@example.com",
          "-N",
          ""
        ],
        "stdout": "Generating public/private ed25519 key pair.\n",
        "create": [
          "<ROOT>/new/ssh/mykey@host",
          "<ROOT>/new/ssh/mykey@host.pub"
        ]
      }
    ],
    "call": {
      "method": "generate",
      "args": [
        "  my key!@host  ",
        "  me@example.com  ",
        ""
      ]
    },
    "modeOf": "<ROOT>/new/ssh",
    "result": "<ROOT>/new/ssh/mykey@host.pub",
    "calls": [
      {
        "argv": [
          "ssh-keygen",
          "-t",
