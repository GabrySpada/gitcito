{
  "method": "subtreePull",
  "fixture": "subtree",
  "case": "pull",
  "repo": "clone",
  "setup": [
    {
      "copy": "subtree-lib.git",
      "as": "LIB"
    },
    {
      "tmpdir": "W"
    },
    {
      "git": [
        "clone",
        "-q",
        "<LIB>",
        "<W>/w"
      ],
      "dir": "<W>"
    },
    {
      "write": "<W>/w/parser.js",
      "content": "exports.parse = () => 42\n"
    },
    {
      "git": [
        "commit",
        "-q",
        "-am",
        "feat: upstream change"
      ],
      "dir": "<W>/w"
    },
    {
      "git": [
        "push",
        "-q",
        "origin",
        "main"
      ],
      "dir": "<W>/w"
    }
  ],
  "args": [
    "<REPO>",
    "vendor/parser",
    "<LIB>",
    "main"
  ],
  "capture": [
    {
      "read": "vendor/parser/parser.js"
    },
    {
      "git": [
        "config",
        "--get-regexp",
        "^gitcito\\."
      ]
    }
  ],
  "extra": [
    "exports.parse = () => 42\n",
    {
      "out": "gitcito.subtree.vendor%2Fparser.url <LIB>\ngitcito.subtree.vendor%2Fparser.ref main"
    }
  ],
  "result": null,
  "state": {
    "index": [
      "100644 <SHA1> 0\tREADME.md",
      "100644 <SHA2> 0\tapp.js",
      "100644 <SHA3> 0\tvendor/parser/README.md",
      "100644 <SHA4> 0\tvendor/parser/parser.js"
    ],
    "log": [
      "<SHA5>\u0000<SHA6> <SHA7>\u0000Merge commit '<SHA7>'",
      "<SHA8>\u0000<SHA9> <SHA10>\u0000Merge commit '<SHA10>' as 'vendor/parser'",
      "<SHA7>\u0000<SHA10>\u0000Squashed 'vendor/parser/' changes from <ABBR1>..<ABBR2>",
      "<SHA10>\u0000\u0000Squashed 'vendor/parser/' content from commit <ABBR1>",
      "<SHA6>\u0000<SHA8>\u0000feat: use safe parse",
      "<SHA9>\u0000\u0000init: app + readme"
    ],
    "refs": [
      "refs/heads/main <SHA5>"
    ],
    "snapshots": [],
    "stash": [],
    "status": []
  }
}
