{
  "method": "worktreeAdd",
  "fixture": "bisect-bug",
  "case": "new-branch",
  "repo": "clone",
  "setup": [
    {
      "tmpdir": "W"
    }
  ],
  "args": [
    "<REPO>",
    "<W>/wt",
    "feature/wt",
    true,
    "HEAD~1"
  ],
  "capture": [
    {
      "git": [
        "worktree",
        "list",
        "--porcelain"
      ]
    },
    {
      "git": [
        "branch",
        "--show-current"
      ],
      "dir": "<W>/wt"
    }
  ],
  "extra": [
    {
      "out": "worktree <REPO>\nHEAD <SHA1>\nbranch refs/heads/main\n\nworktree <W>/wt\nHEAD <SHA2>\nbranch refs/heads/feature/wt"
    },
    {
      "out": "feature/wt"
    }
  ],
