[
  {
    "name": "config reads both lists and the three keys",
    "bins": [
      "git"
    ],
    "replies": [
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "difftool",
          "--tool-help"
        ],
        "stdout": "'git difftool --tool=<tool>' may be set to one of the following:\n\t\tvimdiff          Use Vim\n\t\tmeld             Use Meld (requires a graphical session)\n\nThe following tools are valid, but not currently available:\n\t\tbc               Use Beyond Compare (requires a graphical session)\n\t\taraxis           Use Araxis Merge (requires a graphical session)\n\nSome of the tools listed above only work in a windowed\nenvironment. If run in a terminal-only session, they will fail.\n"
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "mergetool",
          "--tool-help"
        ],
        "stdout": "'git mergetool --tool=<tool>' may be set to one of the following:\n\t\tvimdiff          Use Vim\n\t\tmeld             Use Meld (requires a graphical session)\n\nThe following tools are valid, but not currently available:\n\t\tbc               Use Beyond Compare (requires a graphical session)\n\t\taraxis           Use Araxis Merge (requires a graphical session)\n\nSome of the tools listed above only work in a windowed\nenvironment. If run in a terminal-only session, they will fail.\n",
        "code": 1
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--get",
          "diff.tool"
        ],
        "stdout": "  vimdiff \n"
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--get",
          "merge.tool"
        ],
        "code": 1
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--get",
          "mergetool.keepBackup"
        ],
        "stdout": "false\n"
      }
    ],
    "call": {
      "method": "config",
      "args": [
        "<ROOT>/repo"
      ]
    },
    "result": {
      "diffTool": "vimdiff",
      "mergeTool": "",
      "diffTools": [
        {
          "id": "meld",
          "description": "Use Meld (requires a graphical session)",
          "available": true
        },
        {
          "id": "vimdiff",
          "description": "Use Vim",
          "available": true
        },
        {
          "id": "araxis",
          "description": "Use Araxis Merge (requires a graphical session)",
          "available": false
        },
        {
          "id": "bc",
          "description": "Use Beyond Compare (requires a graphical session)",
          "available": false
        }
      ],
      "mergeTools": [
        {
          "id": "meld",
          "description": "Use Meld (requires a graphical session)",
          "available": true
        },
        {
          "id": "vimdiff",
          "description": "Use Vim",
          "available": true
        },
        {
          "id": "araxis",
          "description": "Use Araxis Merge (requires a graphical session)",
          "available": false
        },
        {
          "id": "bc",
          "description": "Use Beyond Compare (requires a graphical session)",
          "available": false
        }
      ],
      "keepBackup": false
    },
    "calls": [
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--get",
          "diff.tool"
        ],
        "env": {
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--get",
          "merge.tool"
        ],
        "env": {
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--get",
          "mergetool.keepBackup"
        ],
        "env": {
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "difftool",
          "--tool-help"
        ],
        "env": {
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "mergetool",
          "--tool-help"
        ],
        "env": {
          "GIT_TERMINAL_PROMPT": "0"
        },
        "leader": "no"
      }
    ]
