        "code": 255,
        "stderr": "error: could not lock config file /h/.gitconfig: Permission denied\n"
      }
    ],
    "call": {
      "method": "set",
      "args": [
        "<ROOT>/repo",
        {
          "diffTool": "x",
          "mergeTool": "y"
