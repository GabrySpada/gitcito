  {
    "name": "set writes globally by default and unsets an empty choice",
    "bins": [
      "git"
    ],
    "replies": [
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--global",
          "diff.tool",
          "meld"
        ]
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--global",
          "--unset",
          "merge.tool"
        ],
        "code": 5
      },
      {
        "argv": [
          "git",
          "-C",
          "<ROOT>/repo",
          "config",
          "--global",
          "mergetool.keepBackup",
          "false"
        ]
      }
    ],
    "call": {
      "method": "set",
      "args": [
        "<ROOT>/repo",
        {
          "diffTool": "meld",
          "mergeTool": "",
          "keepBackup": false
        }
      ]
    },
    "result": null,
    "calls": [
      {
