node_modules/
out/
dist/
*.log
.DS_Store
examples/playground/

# TypeScript incremental build cache
*.tsbuildinfo

# tree-sitter grammars, copied from node_modules by scripts/sync-grammars.mjs
resources/tree-sitter/
src/renderer/public/tree-sitter/

# Per-developer Claude Code overrides. The shared config (.claude/settings.json,
# hooks, skills, commands) is checked in.
.claude/settings.local.json

# Generated GitHub Pages site (npm run site)
dist-site/

# Generated perf-testing repo (npm run playground:monster) — minutes to build, never wiped automatically
examples/monster/

# Untracked visual references (competitor UI, mockups) — never published
reference/

# Wails frontend build (npm run build:frontend), embedded by the Go binary
# Built renderer (embedded by main.go). The placeholder keeps `go build ./...` and `go vet ./...` working in a
# fresh clone, before any frontend build: //go:embed refuses a missing directory.
frontend-dist/*
!frontend-dist/.gitkeep

# Subagent worktrees created during the Wails port
.claude/worktrees/

# Go build outputs (go build . / wails3 build)
/gitcito
/gitcito.exe
/bin/
/.wails/
